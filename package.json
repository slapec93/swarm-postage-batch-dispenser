{
  "name": "swarm-postage-batch-dispenser",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "start": "node dist/index.js",
    "format": "prettier --write \"src/**/*.ts\" \"pages/*.{html,js}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"pages/*.{html,js}\""
  },
  "license": "BSD-3-Clause",
  "dependencies": {
    "@ethersphere/bee-js": "^13.2.0",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
