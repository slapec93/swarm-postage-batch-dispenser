PORT=3000
# Locally the docker-compose.yml database; on the dev server the shared postgres project
DATABASE_URL=postgres://swarm_postage_batch_dispenser:swarm_postage_batch_dispenser@localhost:5432/swarm_postage_batch_dispenser
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Gateway's Bee node, used for chain price and batch usability checks (compose.prod.yaml defaults to bee:1633)
BEE_API_URL=http://localhost:1633
# Shared secret the gateway sends as Bearer token when resolving team tokens
GATEWAY_SECRET=change-me
# Shown to teams in the bee-js snippet
PUBLIC_GATEWAY_URL=https://api.gateway.ethswarm.org
# Origin allowed to call the API; the frontend is served from Swarm
CORS_ORIGIN=*
# Ethereum address of the gateway's Bee node, set as batch owner
GATEWAY_OWNER_ADDRESS=0x0000000000000000000000000000000000000000

# Dispenser wallet paying for batches (needs xDAI and xBZZ)
WALLET_PRIVATE_KEY=0x...
JSON_RPC_URL=https://xdai.fairdatasociety.org

POOL_SIZE=5
BATCH_DEPTH=22
BATCH_TTL_DAYS=30
POOL_INTERVAL_SECONDS=60
REQUESTS_PER_IP_PER_HOUR=5
